# Server only. Never copy these values into dist/site-config.js.
LEAD_PROVIDER=formsubmit
LEAD_NOTIFICATION_EMAIL=
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LEAD_HASH_SECRET=
# Set only after publishing the documented /api/lead Vercel WAF rule.
LEAD_RATE_LIMIT_MODE=vercel-waf

# Optional: shared 24-hour deduplication + shared application rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Alternative destination. Set LEAD_PROVIDER=webhook only after its durable receipt test.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# Preview deployments do not send real leads by default.
LEAD_PREVIEW_DELIVERY=false
